<Window x:Class="LuxuryClock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Luxury Clock" Height="350" Width="500"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        ResizeMode="NoResize"
        MinHeight="150" MinWidth="200">
    
    <!-- Use 01000000 (near transparent) so the entire window is easily draggable and detects mouse hover perfectly -->
    <Grid x:Name="RootGrid" Background="#01000000" MouseEnter="RootGrid_MouseEnter" MouseLeave="RootGrid_MouseLeave">
        
        <Viewbox Stretch="Uniform" Margin="15">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                
                <!-- Time and Seconds -->
                <Grid Width="460" Height="180" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="370" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" x:Name="TimeText" Text="12:00" 
                               Foreground="White" 
                               FontFamily="Segoe UI Black, Segoe UI" 
                               FontSize="130" 
                               FontWeight="Black" 
                               VerticalAlignment="Center"
                               TextAlignment="Right"
                               Typography.NumeralAlignment="Tabular">
                        <TextBlock.Effect>
                            <DropShadowEffect ShadowDepth="4" BlurRadius="15" Opacity="0.8" Direction="270" Color="Black"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Grid.Column="1" x:Name="SecondsText" Text="00" 
                               Foreground="#E0FFFFFF" 
                               FontFamily="Segoe UI Black, Segoe UI" 
                               FontSize="45" 
                               FontWeight="Bold" 
                               Margin="8,0,0,30" 
                               VerticalAlignment="Bottom"
                               TextAlignment="Left"
                               Typography.NumeralAlignment="Tabular">
                        <TextBlock.Effect>
                            <DropShadowEffect ShadowDepth="2" BlurRadius="10" Opacity="0.7" Direction="270" Color="Black"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </Grid>
            </StackPanel>
        </Viewbox>

        <!-- Sound Toggle Button -->
        <ToggleButton x:Name="SoundToggleBtn" 
                      Width="30" Height="30" 
                      HorizontalAlignment="Left" 
                      VerticalAlignment="Top" 
                      Margin="15" 
                      IsChecked="True" 
                      Cursor="Hand"
                      Visibility="Collapsed">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <Path x:Name="SpeakerPath" Stretch="Uniform" Margin="4" Fill="#CCFFFFFF"
                              Data="M3,9H7L12,4V20L7,15H3V9M16.59,12L14,9.41L15.41,8L18,10.59L20.59,8L22,9.41L19.41,12L22,14.59L20.59,16L18,13.41L15.41,16L14,14.59L16.59,12Z">
                            <Path.Effect>
                                <DropShadowEffect ShadowDepth="1" BlurRadius="5" Opacity="0.8" Color="Black"/>
                            </Path.Effect>
                        </Path>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <!-- High volume icon -->
                            <Setter TargetName="SpeakerPath" Property="Data" Value="M14,3.23V5.29C16.89,6.15 19,8.83 19,12C19,15.17 16.89,17.84 14,18.7V20.77C18,19.86 21,16.28 21,12C21,7.72 18,4.14 14,3.23M16.5,12C16.5,10.23 15.5,8.71 14,7.97V16C15.5,15.29 16.5,13.76 16.5,12M3,9V15H7L12,20V4L7,9H3Z"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="False">
                            <Setter TargetName="SpeakerPath" Property="Fill" Value="#CCFF5555"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
        </ToggleButton>

        <!-- Large 40x40 hit area for the thumb to make it very easy to grab and resize -->
        <Thumb x:Name="ResizeGrip" 
               Width="40" Height="40" 
               HorizontalAlignment="Right" 
               VerticalAlignment="Bottom" 
               Cursor="SizeNWSE"
               DragDelta="ResizeGrip_DragDelta"
               Visibility="Collapsed">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent">
                        <Path Data="M 24,32 L 32,24 L 32,32 Z M 16,32 L 32,16 L 32,20 L 20,32 Z" 
                              Fill="#CCFFFFFF" 
                              HorizontalAlignment="Right" 
                              VerticalAlignment="Bottom" 
                              Margin="0,0,6,6">
                            <Path.Effect>
                                <DropShadowEffect ShadowDepth="1" BlurRadius="5" Opacity="0.8" Color="Black"/>
                            </Path.Effect>
                        </Path>
                    </Grid>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>

    </Grid>
</Window>
