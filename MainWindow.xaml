<Window x:Class="LuxuryClock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Luxury Clock" Height="350" Width="500"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        ResizeMode="NoResize"
        MinHeight="150" MinWidth="200">
    
    <!-- Use 01000000 (near transparent) so the entire window is easily draggable and detects mouse hover perfectly -->
    <Grid x:Name="RootGrid" Background="#01000000" MouseEnter="RootGrid_MouseEnter" MouseLeave="RootGrid_MouseLeave">
        
        <Viewbox Stretch="Uniform" Margin="15">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                
                <!-- Time and Seconds -->
                <Grid Width="460" Height="180" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="370" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" x:Name="TimeText" Text="12:00" 
                               Foreground="White" 
                               FontFamily="Segoe UI Black, Segoe UI" 
                               FontSize="130" 
                               FontWeight="Black" 
                               VerticalAlignment="Center"
                               TextAlignment="Right"
                               Typography.NumeralAlignment="Tabular">
                        <TextBlock.Effect>
                            <DropShadowEffect ShadowDepth="4" BlurRadius="15" Opacity="0.8" Direction="270" Color="Black"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Grid.Column="1" x:Name="SecondsText" Text="00" 
                               Foreground="#E0FFFFFF" 
                               FontFamily="Segoe UI Black, Segoe UI" 
                               FontSize="45" 
                               FontWeight="Bold" 
                               Margin="8,0,0,30" 
                               VerticalAlignment="Bottom"
                               TextAlignment="Left"
                               Typography.NumeralAlignment="Tabular">
                        <TextBlock.Effect>
                            <DropShadowEffect ShadowDepth="2" BlurRadius="10" Opacity="0.7" Direction="270" Color="Black"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </Grid>
            </StackPanel>
        </Viewbox>

        <!-- Large 40x40 hit area for the thumb to make it very easy to grab and resize -->
        <Thumb x:Name="ResizeGrip" 
               Width="40" Height="40" 
               HorizontalAlignment="Right" 
               VerticalAlignment="Bottom" 
               Cursor="SizeNWSE"
               DragDelta="ResizeGrip_DragDelta"
               Visibility="Collapsed">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent">
                        <Path Data="M 24,32 L 32,24 L 32,32 Z M 16,32 L 32,16 L 32,20 L 20,32 Z" 
                              Fill="#CCFFFFFF" 
                              HorizontalAlignment="Right" 
                              VerticalAlignment="Bottom" 
                              Margin="0,0,6,6">
                            <Path.Effect>
                                <DropShadowEffect ShadowDepth="1" BlurRadius="5" Opacity="0.8" Color="Black"/>
                            </Path.Effect>
                        </Path>
                    </Grid>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>

    </Grid>
</Window>
